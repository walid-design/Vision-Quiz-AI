# Server-side OpenAI project key. Never expose this value in the mobile app.
OPENAI_API_KEY=
# Optional model overrides. The defaults use a fast first pass and GPT-4o for
# low-confidence verification.
OPENAI_FAST_VISION_MODEL=gpt-4o-mini
OPENAI_QUALITY_VISION_MODEL=gpt-5.6-terra

# Optional OpenAI-compatible endpoint. Leave blank to use the OpenAI API.
OPENAI_BASE_URL=
