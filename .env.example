# Option A: your own OpenAI project key (stored only on the API server)
OPENAI_API_KEY=
# Optional model overrides. The defaults use a fast first pass and GPT-4o for
# low-confidence verification.
OPENAI_FAST_VISION_MODEL=gpt-4o-mini
OPENAI_QUALITY_VISION_MODEL=gpt-5.6-terra

# Option B is configured by approving "OpenAI (Replit managed)" in Replit.
# Replit supplies AI_INTEGRATIONS_OPENAI_API_KEY and
# AI_INTEGRATIONS_OPENAI_BASE_URL automatically; do not paste them here.
